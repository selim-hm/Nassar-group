<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 560" role="img" aria-labelledby="title desc">
  <title id="title">SuccessTrack Coaching Logo</title>
  <desc id="desc">Dark navy graduation cap with gold growth arrow.</desc>
  <defs>
    <linearGradient id="navy" x1="0%" x2="100%" y1="0%" y2="100%">
      <stop offset="0%" stop-color="#0d2b4e"/>
      <stop offset="100%" stop-color="#09213a"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" x2="100%" y1="0%" y2="100%">
      <stop offset="0%" stop-color="#f5d998"/>
      <stop offset="100%" stop-color="#d7af4b"/>
    </linearGradient>
  </defs>

  <g transform="translate(20 20)">
    <path d="M155 150 L390 60 L605 150 L370 250 Z" fill="url(#navy)" stroke="#f4f6fb" stroke-width="8" stroke-linejoin="round"/>
