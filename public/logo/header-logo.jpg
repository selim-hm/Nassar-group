    <path d="M220 300 L224 272 L264 272 L268 300 Z" fill="#0a2038"/>
    <path d="M388 195 L270 270 L223 270 L350 159 Z" fill="#f4f6fb" opacity="0.92"/>
    <path d="M333 168 L590 66 L625 112 L364 214 Z" fill="#f4f6fb" opacity="0.82"/>

    <g transform="translate(125 110)">
      <path d="M340 155 L550 45 L615 124 L420 255 Z" fill="url(#gold)" stroke="#fefefe" stroke-width="8" stroke-linejoin="round"/>
      <path d="M293 257 L469 114 L518 162 L341 306 Z" fill="url(#gold)" stroke="#fefefe" stroke-width="8" stroke-linejoin="round"/>
