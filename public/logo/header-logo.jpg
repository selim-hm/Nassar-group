      <path d="M514 256 L551 291 L542 323 L500 287 Z" fill="#d7af4b"/>
    </g>

    <path d="M205 310 L165 300 L165 400 L205 410 Z" fill="#0d2b4e"/>
    <path d="M165 300 L180 255 L196 300 Z" fill="#0d2b4e"/>
    <path d="M176 320 C166 340 166 385 176 405 C182 392 198 386 206 388 C193 362 190 340 176 320 Z" fill="#0b1e33"/>
